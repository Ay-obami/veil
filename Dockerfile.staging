# Dockerfile.staging — NON-reproducible image for the state-preservation staging
# validation ONLY (see docs/state-backup-staging.md). Do not use in production.
#
# Differs from the production Dockerfile in exactly one way: GOTOOLCHAIN=auto, so
# Go fetches the toolchain that go.mod requires instead of failing against the
# pinned base image's older Go.
#
# NOTE (found while fixing this file for unrelated reasons — not verified further,
# flagging rather than acting on it): this comment used to say go.mod currently
# requires "go 1.25.8", which needed the base image bumped to match for a real
# reproducible build. This repo's go.mod actually says `go 1.25.1` — exactly
# matching the pinned base image below. If that's accurate, the version mismatch
# this file exists to work around may not apply to this repo at all anymore, and
# the production Dockerfile might build fine without this staging variant. Worth
# checking against docs/state-backup-staging.md's actual purpose before assuming
# that's the whole story, rather than deleting this file on that assumption alone.

FROM golang:1.25.1-trixie@sha256:ff83f3762390c2cccb53618ccc18af23e556aff9b1db4428637e9f63287c8171 AS builder

ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH

# Let Go download the toolchain go.mod requires (the pinned base ships an older Go).
ENV GOTOOLCHAIN=auto

WORKDIR /build

RUN \
  --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  : "${SOURCE_DATE_EPOCH:=$(stat --format=%Y /etc/apt/sources.list.d/debian.sources)}" && \
  snapshot="$(/bin/bash -euc "printf \"%(%Y%m%dT%H%M%SZ)T\n\" \"${SOURCE_DATE_EPOCH}\"")" && \
  sed -i -e '/Types: deb/ a\Snapshot: true' /etc/apt/sources.list.d/debian.sources && \
  rm -f /etc/apt/apt.conf.d/docker-clean && \
  echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' >/etc/apt/apt.conf.d/keep-cache && \
  apt-get install --update --snapshot "${snapshot}" -o Acquire::Check-Valid-Until=false -o Acquire::https::Verify-Peer=false -y ca-certificates && \
  apt-get install --snapshot "${snapshot}" -y ca-certificates && \
  rm -rf /var/log/* /var/cache/ldconfig/aux-cache

COPY --chmod=644 --chown=0:0 . .

RUN go mod download
RUN go mod verify

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS="-buildvcs=false" \
    go build -trimpath -ldflags="-buildid= -s -w" -o /app/extension-tee ./cmd/docker

RUN find /app -exec touch -h -d @${SOURCE_DATE_EPOCH} {} +

FROM gcr.io/distroless/static

WORKDIR /app

COPY --chmod=644 --chown=65532:65532 --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=755 --chown=65532:65532 --from=builder /app/extension-tee /app/extension-tee
ARG NETWORK=coston2
COPY --chmod=644 --chown=65532:65532 config/${NETWORK}/pairs.json /app/config/pairs.json

ARG MODE=0
ENV MODE=$MODE CONFIG_PORT=5501 SIGN_PORT=7701 EXTENSION_PORT=7702

USER 0:0

LABEL "tee.launch_policy.allow_env_override"="LOG_LEVEL,PROXY_URL,INITIAL_OWNER,EXTENSION_ID,CHAIN_URL,MODE,CONFIG_PORT,SIGN_PORT,EXTENSION_PORT"

EXPOSE 5501 7701 7702

CMD ["/app/extension-tee"]
