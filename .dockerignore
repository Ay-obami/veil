# Build context is now this repo's own root (see Dockerfile's top comment) —
# exclude everything the Go build doesn't need, mirroring the various
# .gitignore files already in this repo.

.git/
.github/

# Frontend — not needed by the Go build at all
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Circuits — build scratch; circuits/artifacts/ (the real committed proving
# artifacts) is NOT excluded, everything else under circuits/ is
circuits/node_modules/
circuits/build/

# Go build/test scratch
tools/stress-test
tools/test-setup
tools/traders*.json
**/*.log
logs/
results/*.log

# Local editor/OS noise
.DS_Store
*.swp
